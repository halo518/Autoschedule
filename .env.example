# Copy to .env and fill in. Never commit .env.
# MySQL root (admin only, the app does not use it)
DB_ROOT_PASSWORD=change-me-root
# App DB user "autoschedule"
DB_PASSWORD=change-me
# 32+ bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=
# Optional: enables AI schedule generation
GEMINI_API_KEY=
# true when served over HTTPS
COOKIE_SECURE=false
# Frontend origins if served from another origin, comma separated
CORS_ALLOWED_ORIGINS=
APP_PORT=8080
